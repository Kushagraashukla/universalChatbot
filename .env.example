# Copy to .env and adjust. Every value here is optional; the defaults are shown.
# Never commit .env. This file must stay free of real secrets.

# --- Models (Ollama) ---
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Storage ---
# CHROMA_DIR=E:\chroma_db
# APPS_CONFIG=config/apps.json

# --- API ---
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAG_MAX_QUESTION_CHARS=2000
RAG_LOG_LEVEL=INFO

# --- Per-app API keys (only for apps that set "api_key_env" in config/apps.json) ---
# MY_APP_API_KEY=replace-with-a-long-random-value
